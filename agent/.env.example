# --- Required for Arc Testnet live trading only ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- Control plane ---
AGENT_ADMIN_TOKEN=
AGENT_PORT=8787

# --- Arc Testnet deployments ---
VITE_FACTORY_ADDRESS=
VITE_MARKET_ADDRESS=
AGENT_START_BLOCK=

# --- Chain selection ---
# Defaults to Arc Testnet (5042002). Ethereum (1), Base (8453), and other chains with USDC
# facts can be selected for RPC/read-only groundwork; this does not enable marketplace trading.
AGENT_CHAIN_ID=5042002
RPC_URL_Arc_Testnet=
AGENT_WS_URL=

# --- Optional chain-specific configuration (do not reuse Arc addresses) ---
# RPC_URL_Ethereum=
# RPC_URL_Base=
# AGENT_FACTORY_ADDRESS_1=
# AGENT_MARKET_ADDRESS_1=
# AGENT_FACTORY_ADDRESS_8453=
# AGENT_MARKET_ADDRESS_8453=
# AGENT_WS_URL_1=
# AGENT_WS_URL_8453=

# --- Optional ---
AGENT_DB_PATH=agent/data/agent.sqlite
AGENT_PAPER_BALANCE=100000000
AGENT_LOG_LEVEL=info
AGENT_DASHBOARD_DIR=dist
