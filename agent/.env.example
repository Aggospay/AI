# Copy these names into your host's secret manager. Never commit real values.

# --- Required for live testnet trading and rival wallets ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- Control plane ---
# Bearer token the dashboard uses. The worker creates one on first start if missing (local dev only).
AGENT_ADMIN_TOKEN=
AGENT_PORT=8787

# --- Deployed contracts (public addresses) ---
VITE_FACTORY_ADDRESS=
VITE_MARKET_ADDRESS=
# Block where the factory was deployed. The indexer never starts from block 0.
AGENT_START_BLOCK=

# --- Chain access ---
# Strongly recommended on an always-on host: your own RPC provider for Arc Testnet.
RPC_URL_Arc_Testnet=
# Optional WebSocket endpoint for low-latency head notifications (polling is used otherwise).
AGENT_WS_URL=

# --- Optional ---
AGENT_DB_PATH=agent/data/agent.sqlite
AGENT_PAPER_BALANCE=100000000
AGENT_LOG_LEVEL=info
AGENT_DASHBOARD_DIR=dist
